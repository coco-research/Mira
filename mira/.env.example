# Mira secrets — COPY THIS FILE TO `.env` (same folder) AND PASTE YOUR VALUES.
#
#   cp .env.example .env      # then edit .env
#
# `.env` is git-ignored (never committed, never synced). Keys are read locally by
# mira/keys.py and NEVER sent over the dashboard HTTP API. A missing/empty key just
# downgrades that feature to its free/offline path — it never crashes the pipeline.
#
# Format: KEY=value  (no quotes needed, no spaces around =). Lines starting with # are ignored.

# ─────────────────────────────────────────────────────────────────────────────
# CINEMATIC VISUALS — the keys that actually change "text cards" → real footage
# ─────────────────────────────────────────────────────────────────────────────

# Veo via Google (MOST cinematic; you already pay for this through Gemini Pro / Vertex).
# Get it: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Pexels stock footage + photos (FREE key, instant). Real cinematic b-roll behind narration.
# Get it: https://www.pexels.com/api/
PEXELS_API_KEY=

# Pixabay stock video + photos + music (FREE key). Second stock source / fallback.
# Get it: https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# LLM POOL (scripts) — all optional; LM Studio (local) works with zero keys
# ─────────────────────────────────────────────────────────────────────────────
NIM_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
GITHUB_MODELS_TOKEN=
HUGGINGFACE_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# VOICE / AUDIO — edge-tts is free & keyless; these are upgrades
# ─────────────────────────────────────────────────────────────────────────────
SARVAM_API_KEY=          # best Hindi voice
ELEVENLABS_API_KEY=      # premium English voice
FREESOUND_TOKEN=         # SFX library
SUNO_API_KEY=            # AI music (optional)

# ─────────────────────────────────────────────────────────────────────────────
# MOTION CONTROL / AVATAR (optional, advanced)
# ─────────────────────────────────────────────────────────────────────────────
MUAPI_KEY=               # Kling motion-control / V2V

# ─────────────────────────────────────────────────────────────────────────────
# PUBLISHING (parked — not needed for the quality lab)
# ─────────────────────────────────────────────────────────────────────────────
YOUTUBE_CLIENT_SECRET_JSON=
YOUTUBE_API_KEY=
IG_ACCESS_TOKEN=
BLOTATO_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# CLOUD GPU BURST (only if you rent NVIDIA GPUs for SkyReels/Wan — costs credits)
# ─────────────────────────────────────────────────────────────────────────────
VULTR_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# MULTI-USER / POD (parked)
# ─────────────────────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_AGENT_KEY=
MIRA_LOCAL_TOKEN=
